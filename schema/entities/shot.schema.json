{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorts.director/schemas/v1/shot.json",
  "title": "Shot",
  "description": "可用的最小剪辑单元（L2 物料层）。元数据分五组：identity / semantic / affordance / technical / compliance，外加 lifecycle。状态机（显式 FSM，禁止布尔字段拼装）：UPLOADED→SEGMENTED→TAGGED→QC_L0→(fail:REJECTED→RESHOOT_REQUESTED | pass:AVAILABLE⇄COOLING)；AVAILABLE 可→EXPIRED(ttl) / QUARANTINED(合规)。跨字段不变式（实现侧逐条校验）：IV-SH-1 safe_crop_9x16.ok=false 的 shot 不得进入任何 9:16 slot 候选池（除非声明 pillarbox 处理）；IV-SH-2 compliance.risk_flags 非空 ⇒ usable=false，直到人工放行或打码完成；IV-SH-3 ttl_at < now() ⇒ 自动出候选池并触发 ReshootTask。",
  "type": "object",
  "required": [
    "id",
    "asset_id",
    "tenant_id",
    "state",
    "identity",
    "semantic",
    "affordance",
    "technical",
    "compliance",
    "lifecycle",
    "tag_provenance"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "asset_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "state": {
      "enum": [
        "UPLOADED",
        "SEGMENTED",
        "TAGGED",
        "REJECTED",
        "AVAILABLE",
        "COOLING",
        "EXPIRED",
        "QUARANTINED"
      ]
    },
    "identity": {
      "type": "object",
      "required": ["in_frame", "out_frame", "fps"],
      "properties": {
        "in_frame": { "type": "integer", "minimum": 0 },
        "out_frame": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "enum": [25, 30] },
        "duration_frames": {
          "type": "integer",
          "minimum": 1,
          "description": "生成列：out_frame - in_frame"
        }
      },
      "additionalProperties": false
    },
    "semantic": {
      "type": "object",
      "description": "全部来自受控词表（VLM 打标输出受 BAML enum 约束）",
      "properties": {
        "shot_type": { "description": "vocab/shot_type" },
        "shot_type_classes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "等价类展开存储，支撑 && 查询"
        },
        "camera_motion_type": { "description": "vocab/camera_motion" },
        "camera_motion_dir": {
          "enum": ["LEFT", "RIGHT", "IN", "OUT", "UP", "DOWN", null],
          "description": "STATIC 时为 null；镜像翻转规则见变形测试 §4.5"
        },
        "scene": { "description": "vocab/scene.<vertical>" },
        "subjects": {
          "type": "array",
          "maxItems": 5,
          "items": { "description": "vocab/subject.<vertical>，按显著性降序" }
        },
        "actions": {
          "type": "array",
          "items": { "description": "vocab/action" }
        },
        "mood": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "affordance": {
      "type": "object",
      "description": "可剪辑性（决定该 shot 能被怎样使用）",
      "properties": {
        "is_loopable": { "type": "boolean" },
        "clean_in": { "type": "boolean" },
        "clean_out": { "type": "boolean" },
        "camera_motion": {
          "type": "object",
          "properties": {
            "type": { "description": "vocab/camera_motion" },
            "dir": {
              "enum": ["LEFT", "RIGHT", "IN", "OUT", "UP", "DOWN", null]
            },
            "confidence": { "type": "number" }
          },
          "additionalProperties": false
        },
        "negative_space": {
          "type": "array",
          "items": { "enum": ["TOP", "BOTTOM", "LEFT", "RIGHT"] },
          "description": "跨帧交集的可用字幕区域（面积>画面15%）"
        },
        "subject_bbox_track": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "frame": { "type": "integer" },
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "w": { "type": "integer" },
              "h": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "safe_crop_9x16": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {
              "type": "boolean",
              "description": "假阳性率必须<5%（断头视频比缺素材严重）"
            },
            "method": {
              "enum": ["CENTER_CROP", "RECENTER", "PILLARBOX", "NONE"],
              "description": "IV-SH-1：ok=false 且需进入候选池时必须声明 PILLARBOX"
            }
          },
          "additionalProperties": false
        },
        "has_speech": { "type": "boolean" },
        "has_lipsync": { "type": "boolean" },
        "motion_energy": { "type": "number", "description": "0–1，光流归一" }
      },
      "additionalProperties": false
    },
    "technical": {
      "type": "object",
      "description": "确定性算法测得（VLM 禁止重新判断，BAML 契约条款 B-2）",
      "properties": {
        "sharpness": { "type": "number", "description": "laplacian_var" },
        "niqe": { "type": "number" },
        "shake_score": { "type": "number" },
        "exposure_hist": { "type": "array", "items": { "type": "integer" } },
        "color_temp": { "type": "integer" },
        "flicker_score": { "type": "number" },
        "audio": {
          "type": "object",
          "properties": {
            "lufs": { "type": "number" },
            "snr": { "type": "number" }
          },
          "additionalProperties": false
        },
        "quality_tier": { "type": "integer", "minimum": 1, "maximum": 4 }
      },
      "additionalProperties": false
    },
    "compliance": {
      "type": "object",
      "properties": {
        "third_party_faces": { "type": "array", "items": { "type": "string" } },
        "third_party_logos": { "type": "array", "items": { "type": "string" } },
        "plates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "车牌"
        },
        "ocr_text": { "type": "array", "items": { "type": "string" } },
        "risk_flags": {
          "type": "array",
          "items": {
            "description": "vocab/compliance_risk；非空 ⇒ QUARANTINED（IV-SH-2）"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "shot_date": { "type": ["string", "null"], "format": "date" },
        "seasons": {
          "type": "array",
          "items": { "description": "vocab/season" },
          "description": "默认 [ALL]"
        },
        "ttl_class": { "description": "vocab/ttl_class" },
        "ttl_at": { "type": ["string", "null"], "format": "date" },
        "linked_skus": { "type": "array", "items": { "type": "string" } },
        "linked_campaigns": { "type": "array", "items": { "type": "string" } },
        "use_count": { "type": "integer", "minimum": 0 },
        "last_used_at": { "type": ["string", "null"], "format": "date" }
      },
      "additionalProperties": false
    },
    "tag_provenance": {
      "$ref": "https://shorts.director/schemas/v1/common/provenance.json"
    }
  },
  "additionalProperties": false
}
