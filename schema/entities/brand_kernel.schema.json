{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorts.director/schemas/v1/brand_kernel.json",
  "title": "BrandKernel",
  "description": "Onboarding 苏格拉底问答的唯一产物，全系统根契约（L4 意图层）。跨字段不变式（实现侧逐条校验）：IV-BK-1 pillars 至少 3 个，每个至少绑定 2 种 proof_type；IV-BK-2 completeness.score ≥ 0.75 才允许进入 L3 匹配（访谈停止条件=槽位覆盖度而非轮次）；IV-BK-3 category 必须来自受控枚举并决定 ComplianceProfile，禁止 LLM 自由生成。",
  "type": "object",
  "required": [
    "schema_version",
    "tenant_id",
    "category",
    "identity",
    "audience",
    "pillars",
    "assets_intent",
    "compliance_profile_id",
    "completeness"
  ],
  "properties": {
    "schema_version": { "const": "brand_kernel/1" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "category": {
      "type": "string",
      "description": "受控枚举（business_category 词表，后续 PR 冻结）；IV-BK-3"
    },
    "identity": {
      "type": "object",
      "required": ["name", "one_liner", "differentiators", "persona"],
      "properties": {
        "name": { "type": "string" },
        "one_liner": { "type": "string", "maxLength": 40 },
        "differentiators": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "description": "差异点必须可视觉验证",
          "items": {
            "type": "object",
            "required": ["claim", "visual_provable", "proof_types"],
            "properties": {
              "claim": { "type": "string", "maxLength": 30 },
              "visual_provable": { "type": "boolean" },
              "proof_types": {
                "type": "array",
                "minItems": 1,
                "items": { "description": "vocab/proof_type" }
              },
              "verified_at": {
                "type": ["string", "null"],
                "format": "date",
                "description": "事实漂移防线（§8.2-①）：主张核验日期，到期触发轻量确认"
              }
            },
            "additionalProperties": false
          }
        },
        "persona": {
          "type": "object",
          "description": "口播人格，驱动 TTS 与文风",
          "properties": {
            "voice_tone": {
              "enum": ["WARM", "EXPERT", "STREET", "PLAYFUL", "CALM"]
            },
            "speaking_rate": { "enum": ["SLOW", "NORMAL", "FAST"] },
            "first_person": { "enum": ["OWNER", "STAFF", "BRAND", "CUSTOMER"] },
            "dialect_hint": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audience": {
      "type": "object",
      "required": ["segments", "local_radius_km", "decision_trigger"],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["label", "pain", "objection"],
            "properties": {
              "label": { "type": "string" },
              "pain": { "type": "string" },
              "objection": {
                "type": "string",
                "description": "抗拒点，驱动 CONTRAST beat"
              }
            },
            "additionalProperties": false
          }
        },
        "local_radius_km": { "type": "number", "exclusiveMinimum": 0 },
        "decision_trigger": {
          "enum": ["IMPULSE", "PLANNED", "REFERRAL", "SEASONAL"]
        }
      },
      "additionalProperties": false
    },
    "pillars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "label", "intent", "proof_types", "target_ratio"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "intent": {
            "enum": ["AWARENESS", "TRUST", "DESIRE", "CONVERSION", "RETENTION"]
          },
          "proof_types": {
            "type": "array",
            "minItems": 2,
            "items": { "description": "vocab/proof_type（IV-BK-1）" }
          },
          "target_ratio": { "type": "number", "minimum": 0.05, "maximum": 0.6 }
        },
        "additionalProperties": false
      }
    },
    "assets_intent": {
      "type": "object",
      "required": ["shootable_scenes", "non_shootable_needs", "digital_human"],
      "properties": {
        "shootable_scenes": {
          "type": "array",
          "items": { "description": "vocab/scene.<vertical>" }
        },
        "non_shootable_needs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "digital_human": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "source": { "enum": ["REAL_OWNER", "REAL_STAFF", "STOCK_AVATAR"] },
            "authorization_id": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "offers": {
      "type": "array",
      "description": "可轮换 OFFER 池，避免每天同一句",
      "items": {
        "type": "object",
        "required": ["text", "valid_from", "valid_to", "claim_risk"],
        "properties": {
          "text": { "type": "string" },
          "valid_from": { "type": "string", "format": "date" },
          "valid_to": { "type": "string", "format": "date" },
          "claim_risk": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "verified_at": {
            "type": ["string", "null"],
            "format": "date",
            "description": "价格/活动事实最易漂移，核验到期在交付卡片做轻量确认"
          }
        },
        "additionalProperties": false
      }
    },
    "hard_negatives": {
      "type": "array",
      "items": { "type": "string" },
      "description": "明确禁止的表达/画面，来自访谈"
    },
    "compliance_profile_id": { "type": "string" },
    "completeness": {
      "type": "object",
      "required": ["score", "missing_slots", "interview_turns"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "missing_slots": { "type": "array", "items": { "type": "string" } },
        "interview_turns": { "type": "integer", "minimum": 0, "maximum": 18 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "$ref": "https://shorts.director/schemas/v1/common/provenance.json"
    }
  },
  "additionalProperties": false
}
