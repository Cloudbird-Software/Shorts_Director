{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorts.director/schemas/v1/production_order.json",
  "title": "ProductionOrder",
  "description": "制作令——\"创意→工业采购规格\"的翻译器，与外包/商家的合同界面。同一真源双视图：机器可读 JSON + 人类可执行 shot list（含 AI 构图示意图）。spec.technical.handles_sec（首尾余量）是外包实拍素材可用率的最大单点杠杆。状态机：DRAFTED→DISPATCHED→SUBMITTED→QC_RUNNING→{ACCEPTED|REWORK_REQUESTED(n)|REJECTED}，REWORK 必须携带结构化 RemedyInstruction[]。",
  "type": "object",
  "required": [
    "order_id",
    "tenant_id",
    "kind",
    "vendor_type",
    "items",
    "acceptance_spec",
    "deadline",
    "budget_cents"
  ],
  "properties": {
    "order_id": { "type": "string" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "kind": {
      "enum": [
        "REAL_SHOOT",
        "GEN_AVATAR",
        "GEN_BROLL",
        "UGC_RESHOOT",
        "GRAPHIC"
      ]
    },
    "vendor_type": {
      "enum": ["PHOTOGRAPHER", "GEN_VENDOR", "MERCHANT_SELF", "INTERNAL"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "intent", "spec", "acceptance_assertions"],
        "properties": {
          "item_id": { "type": "string" },
          "intent": {
            "type": "object",
            "required": ["serves_slots", "pillar_id", "narrative_note"],
            "description": "为什么要这个镜头（给人看）",
            "properties": {
              "serves_slots": {
                "type": "array",
                "items": { "type": "string" }
              },
              "pillar_id": { "type": "string" },
              "narrative_note": { "type": "string" }
            },
            "additionalProperties": false
          },
          "spec": {
            "type": "object",
            "required": [
              "shot_type",
              "camera_motion",
              "scene",
              "subject",
              "duration_sec",
              "framing",
              "technical"
            ],
            "properties": {
              "shot_type": { "description": "vocab/shot_type" },
              "camera_motion": {
                "type": "object",
                "properties": {
                  "type": { "description": "vocab/camera_motion" },
                  "dir": {
                    "enum": ["LEFT", "RIGHT", "IN", "OUT", "UP", "DOWN", null]
                  }
                },
                "additionalProperties": false
              },
              "scene": { "description": "vocab/scene.<vertical>" },
              "subject": {
                "type": "array",
                "items": { "description": "vocab/subject.<vertical>" }
              },
              "action": { "description": "vocab/action" },
              "duration_sec": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number", "exclusiveMinimum": 0 },
                "description": "[min,max] 目标时长（秒，拍摄规格用秒，入库后转帧）"
              },
              "framing": {
                "type": "object",
                "required": [
                  "subject_area_ratio",
                  "negative_space",
                  "headroom"
                ],
                "properties": {
                  "subject_area_ratio": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "number" }
                  },
                  "negative_space": {
                    "enum": ["TOP", "BOTTOM", "LEFT", "RIGHT", "NONE"]
                  },
                  "headroom": { "enum": ["TIGHT", "NORMAL", "LOOSE"] },
                  "reference_image_url": {
                    "type": "string",
                    "description": "AI 生成构图示意图（商家自拍场景必备）"
                  }
                },
                "additionalProperties": false
              },
              "coverage": {
                "type": "array",
                "items": {
                  "enum": ["MASTER", "INSERT", "REACTION", "ALT_ANGLE"]
                }
              },
              "technical": {
                "type": "object",
                "properties": {
                  "min_resolution": { "const": "1080x1920" },
                  "min_fps": { "type": "integer", "default": 30 },
                  "handles_sec": {
                    "type": "number",
                    "default": 1,
                    "description": "首尾余量，可用率最大杠杆"
                  },
                  "clean_in_out": { "type": "boolean", "default": true },
                  "no_talking_unless": { "type": "boolean", "default": true },
                  "lighting": {
                    "enum": ["NATURAL", "SOFT_KEY", "AMBIENT_ONLY"]
                  },
                  "audio_required": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "acceptance_assertions": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "https://shorts.director/schemas/v1/qc_assertion.json"
            },
            "description": "合同界面：机器可读验收条款"
          },
          "hard_negatives": {
            "type": "array",
            "items": { "type": "string" },
            "description": "反例说明（配合反例图，商家自拍场景必备）"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_spec": {
      "type": "object",
      "required": [
        "auto_gate_level",
        "rework_rounds_included",
        "payment_terms"
      ],
      "properties": {
        "auto_gate_level": { "enum": ["L0", "L0+L1", "L0+L1+L2"] },
        "rework_rounds_included": { "type": "integer", "minimum": 0 },
        "payment_terms": { "type": "string" },
        "pass_threshold": {
          "type": "object",
          "properties": {
            "blocker_count": { "const": 0 },
            "major_count_max": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "deadline": { "type": "string", "format": "date-time" },
    "budget_cents": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
