{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorts.director/schemas/v1/shot_slot_query.json",
  "title": "ShotSlotQuery",
  "description": "把\"我要什么样的镜头\"表达为可编译成参数化 SQL 的谓词 AST（受限表达力：字段白名单 + 受控操作符）。L3 范式层引用 L2 物料层的唯一形式——只允许等价类谓词，禁止引用具体 shot/asset 实例。跨字段不变式（实现侧逐条校验，见 invariants 包）：IV-SQ-1 fallback_chain 末端必须命中永远可用的兜底类（is_terminal_graphic=true 或等价类兜底），任何 slot 不允许无解；IV-SQ-2 must 中只允许白名单字段与受控词表内的取值。",
  "type": "object",
  "required": ["slot_id", "must", "fallback_chain", "consumption_policy"],
  "properties": {
    "slot_id": {
      "type": "string",
      "description": "beat 内唯一，如 hook.detail"
    },
    "must": {
      "type": "array",
      "items": { "$ref": "#/$defs/Predicate" },
      "description": "硬条件，不满足则该级 slot 失败。空数组语义为\"接受候选池任意成员\"，仅终端图形兜底允许"
    },
    "should": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predicate", "weight"],
        "properties": {
          "predicate": { "$ref": "#/$defs/Predicate" },
          "weight": { "type": "number", "minimum": -5, "maximum": 5 }
        },
        "additionalProperties": false
      },
      "description": "软条件，仅用于排序打分，不影响可行性"
    },
    "forbid": {
      "type": "array",
      "items": { "$ref": "#/$defs/Predicate" },
      "description": "一票否决条件（如 forbid third_party_face）"
    },
    "fallback_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["level", "must", "degrade_note"],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 0,
            "description": "0 为原始查询，逐级放宽"
          },
          "must": { "type": "array", "items": { "$ref": "#/$defs/Predicate" } },
          "degrade_note": {
            "type": "string",
            "description": "降级代价说明，落盘到 constraints_report.fallbacks_used"
          },
          "is_terminal_graphic": {
            "type": "boolean",
            "default": false,
            "description": "终端兜底：Remotion 图形卡（card.terminal_fallback），永远可解"
          }
        },
        "additionalProperties": false
      },
      "description": "降级链。IV-SQ-1：链末端必须可解（is_terminal_graphic 或无条件兜底）"
    },
    "consumption_policy": {
      "type": "object",
      "required": ["cooldown_days", "max_uses_per_30d"],
      "properties": {
        "cooldown_days": { "type": "integer", "minimum": 0 },
        "max_uses_per_30d": { "type": "integer", "minimum": 1 },
        "prefer_least_used": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Field": {
      "enum": [
        "shot_type",
        "shot_type_class",
        "camera_motion.type",
        "camera_motion.dir",
        "scene",
        "subject",
        "action",
        "mood",
        "is_loopable",
        "clean_in",
        "clean_out",
        "has_speech",
        "has_lipsync",
        "negative_space",
        "safe_crop_9x16.ok",
        "motion_energy",
        "duration",
        "sharpness_tier",
        "quality_tier",
        "season",
        "ttl_at",
        "linked_sku",
        "use_count",
        "last_used_at",
        "source_kind"
      ],
      "description": "字段白名单（IV-SQ-2）。新增字段 = 编译器与索引同步变更，PR 必须附 property test"
    },
    "Predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "field", "value"],
          "properties": {
            "op": { "enum": ["eq", "in", "neq", "nin"] },
            "field": { "$ref": "#/$defs/Field" },
            "value": {
              "description": "eq/neq 为标量；in/nin 为数组。取值受控于对应词表（运行时由 invariants 层校验）"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "field", "value"],
          "properties": {
            "op": { "enum": ["gte", "lte", "gt", "lt"] },
            "field": { "$ref": "#/$defs/Field" },
            "value": { "type": "number" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "field", "range"],
          "properties": {
            "op": { "const": "between" },
            "field": { "$ref": "#/$defs/Field" },
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "query", "top_k"],
          "properties": {
            "op": { "const": "semantic" },
            "query": {
              "type": "string",
              "description": "编译为 pgvector 子查询；仅允许出现在 should"
            },
            "top_k": { "type": "integer", "minimum": 1, "maximum": 50 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "operands"],
          "properties": {
            "op": { "enum": ["and", "or", "not"] },
            "operands": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/Predicate" }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
