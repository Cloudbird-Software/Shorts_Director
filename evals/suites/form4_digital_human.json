{
  "schema_version": 1,
  "suite_id": "form4_digital_human_v100",
  "gen_form": "DIGITAL_HUMAN",
  "op": "gen_lipsync",
  "model": "wav2lip",
  "seeds": [7, 42, 1013, 2026, 31337],
  "fps": 25,
  "params": { "width": 1080, "height": 1920 },
  "entries": [
    {
      "id": "yueyan_beauty",
      "image_path": "evals/merchants/yueyan_beauty/seed_portrait.png",
      "prompt": "悦颜美甲128元，预约13700009012",
      "duration_sec": 6
    },
    {
      "id": "noodles_lanjie",
      "image_path": "evals/merchants/noodles_lanjie/seed_portrait.png",
      "prompt": "兰姐牛肉面28元，外卖13800001234",
      "duration_sec": 6
    },
    {
      "id": "valley_coffee",
      "image_path": "evals/merchants/valley_coffee/seed_portrait.png",
      "prompt": "山谷咖啡32元，来店13900005678",
      "duration_sec": 6
    }
  ],
  "assertion_pack": [
    {
      "assertion_id": "L0.duration_upper_bound",
      "level": "L0",
      "severity": "BLOCKER",
      "probe": { "op": "ffprobe_field", "args": { "field": "duration_sec" } },
      "expect": { "op": "lte", "value": 6.0 },
      "remedy": {
        "action": "TRIM",
        "instruction_template": "时长 {{measured}}s 超制式上限 6.0s，缩口播或加速"
      }
    },
    {
      "assertion_id": "L0.canvas_width",
      "level": "L0",
      "severity": "BLOCKER",
      "probe": { "op": "resolution", "args": { "dim": "width" } },
      "expect": { "op": "eq", "value": 1080 },
      "remedy": {
        "action": "RE_CROP",
        "instruction_template": "宽 {{measured}} ≠ 1080，按 9:16 画幅重裁"
      }
    },
    {
      "assertion_id": "L0.canvas_height",
      "level": "L0",
      "severity": "BLOCKER",
      "probe": { "op": "resolution", "args": { "dim": "height" } },
      "expect": { "op": "eq", "value": 1920 },
      "remedy": {
        "action": "RE_CROP",
        "instruction_template": "高 {{measured}} ≠ 1920，按 9:16 画幅重裁"
      }
    },
    {
      "assertion_id": "L2.lipsync_confidence",
      "level": "L2",
      "severity": "MAJOR",
      "probe": { "op": "lipsync_lse_c", "args": {} },
      "expect": { "op": "gte", "value": 6.0 },
      "remedy": {
        "action": "REGENERATE",
        "instruction_template": "口型同步置信度 {{measured}} 低于阈值 6.0（SyncNet LSE-C），重抽或换后端"
      }
    },
    {
      "assertion_id": "L2.lipsync_distance",
      "level": "L2",
      "severity": "MAJOR",
      "probe": { "op": "lipsync_lse_d", "args": {} },
      "expect": { "op": "lte", "value": 8.4 },
      "remedy": {
        "action": "REGENERATE",
        "instruction_template": "口型同步距离 {{measured}} 超过阈值 8.4（SyncNet LSE-D），重抽或换后端"
      }
    },
    {
      "assertion_id": "L3.aigc_disclosure_overlay",
      "level": "L3",
      "severity": "BLOCKER",
      "probe": { "op": "aigc_overlay_present", "args": {} },
      "expect": { "op": "gte", "value": 0.005 },
      "remedy": {
        "action": "ADD_DISCLAIMER",
        "instruction_template": "AIGC 角标区域差异占比 {{measured}}，披露文案未叠加"
      }
    },
    {
      "assertion_id": "L3.aigc_implicit_metadata",
      "level": "L3",
      "severity": "BLOCKER",
      "probe": { "op": "aigc_metadata_present", "args": {} },
      "expect": { "op": "is_true", "value": true },
      "remedy": {
        "action": "ADD_DISCLAIMER",
        "instruction_template": "容器元数据缺完整 AIGC 隐式标识块"
      }
    }
  ],
  "budget": { "wall_seconds": 7200, "gpu_seconds": 5400 }
}
