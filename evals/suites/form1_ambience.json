{
  "schema_version": 1,
  "suite_id": "form1_ambience_v100",
  "gen_form": "I2V_AMBIENCE",
  "op": "gen_i2v",
  "model": "ltx-video-2b",
  "seeds": [7, 42, 1013, 2026, 31337],
  "fps": 24,
  "params": { "width": 1080, "height": 1920, "num_inference_steps": 25 },
  "entries": [
    {
      "id": "noodles_lanjie",
      "image_path": "evals/merchants/noodles_lanjie/seed_hero.png",
      "prompt": "一碗热气腾腾的牛肉面特写，镜头缓慢推近，蒸汽升腾，暖色灯光，氛围感空镜",
      "duration_sec": 6
    },
    {
      "id": "valley_coffee",
      "image_path": "evals/merchants/valley_coffee/seed_hero.png",
      "prompt": "咖啡店吧台手冲咖啡的特写，水流缓慢注入滤杯，蒸汽与暖光，氛围感空镜",
      "duration_sec": 6
    },
    {
      "id": "yueyan_beauty",
      "image_path": "evals/merchants/yueyan_beauty/seed_hero.png",
      "prompt": "美甲工作室桌面灯光渐亮，甲油色板与工具的柔焦空镜，缓慢横移",
      "duration_sec": 6
    }
  ],
  "assertion_pack": [
    {
      "assertion_id": "L0.duration_in_form_range",
      "level": "L0",
      "severity": "BLOCKER",
      "probe": { "op": "ffprobe_field", "args": { "field": "duration_sec" } },
      "expect": { "op": "between", "value": [5, 8] },
      "remedy": {
        "action": "TRIM",
        "instruction_template": "时长 {{measured}}s 超出形态区间 5–8s，裁剪或重抽"
      }
    },
    {
      "assertion_id": "L0.canvas_width",
      "level": "L0",
      "severity": "BLOCKER",
      "probe": { "op": "resolution", "args": { "dim": "width" } },
      "expect": { "op": "eq", "value": 1080 },
      "remedy": {
        "action": "RE_CROP",
        "instruction_template": "宽 {{measured}} ≠ 1080，按 9:16 画幅重裁"
      }
    },
    {
      "assertion_id": "L0.canvas_height",
      "level": "L0",
      "severity": "BLOCKER",
      "probe": { "op": "resolution", "args": { "dim": "height" } },
      "expect": { "op": "eq", "value": 1920 },
      "remedy": {
        "action": "RE_CROP",
        "instruction_template": "高 {{measured}} ≠ 1920，按 9:16 画幅重裁"
      }
    },
    {
      "assertion_id": "L0.black_ratio",
      "level": "L0",
      "severity": "MAJOR",
      "probe": { "op": "blackdetect_ratio", "args": {} },
      "expect": { "op": "lte", "value": 0.01 },
      "remedy": {
        "action": "REGENERATE",
        "instruction_template": "黑帧占比 {{measured}}，生成异常需重抽"
      }
    },
    {
      "assertion_id": "L3.aigc_disclosure_overlay",
      "level": "L3",
      "severity": "BLOCKER",
      "probe": { "op": "aigc_overlay_present", "args": {} },
      "expect": { "op": "is_true", "value": true },
      "remedy": {
        "action": "ADD_DISCLAIMER",
        "instruction_template": "缺 AIGC 标识，信息层必须叠加披露文案"
      }
    }
  ],
  "budget": { "wall_seconds": 14400, "gpu_seconds": 10800 }
}
